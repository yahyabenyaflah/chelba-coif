# Copiez ce fichier vers .env.local et renseignez les valeurs réelles.
# Ne commitez jamais .env.local (déjà ignoré par .gitignore).

# URL de connexion PostgreSQL Neon (avec ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Clé de signature des sessions (JWT). 32 caractères minimum.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Cloudinary (tableau de bord Cloudinary > Dashboard)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Même valeur que CLOUDINARY_CLOUD_NAME ci-dessus, exposée au navigateur.
# Ce n'est pas un secret : le nom de cloud apparaît de toute façon dans
# chaque URL d'image publique. Nécessaire pour afficher les images côté client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Notification e-mail à l'admin pour chaque nouvelle réservation. Facultatif :
# tant que ces 3 valeurs ne sont pas toutes renseignées, l'envoi est
# simplement désactivé (le site fonctionne normalement sans).
#   1. Créez un compte gratuit sur https://resend.com
#   2. Récupérez une clé API (Dashboard > API Keys)
#   3. Sans domaine vérifié, utilisez l'expéditeur de test fourni par Resend :
#      onboarding@resend.dev (fonctionne immédiatement, sans configuration DNS)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
ADMIN_NOTIFICATION_EMAIL=""

# URL publique du site une fois déployé (ex. https://chelba-coif.vercel.app
# ou votre domaine personnalisé). Utilisée pour les liens absolus (lien vers
# le dashboard dans l'e-mail de notification, métadonnées de partage).
SITE_URL=""
